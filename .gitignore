coverage/

# On case-insensitive filesystems (default macOS APFS), ~/StudyLoop resolves to
# this same repo directory as ~/studyloop. The default dataDir writes project
# data under <dataDir>/projects — never commit runtime study data. F11's
# review.json lands directly under dataDir (not per-project) — same reasoning.
# V3-C C1's teacherScores.json is the same dataDir-root-level shape.
/projects/
/review.json
/teacherScores.json
/conceptRegistry.json
.claude/
.gstack/

# Playwright smoke harness — generated fixture install (config/data/library)
# and test output, regenerated by e2e/fixtures/seed.mjs on every `npm run e2e`.
/e2e/.tmp/
/test-results/
/playwright-report/
/blob-report/
